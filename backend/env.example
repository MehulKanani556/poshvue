# Copy this file to .env and fill in your values

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/poshvue

# Server
PORT=5000

# Auth
JWT_SECRET=your_jwt_secret
ADMIN_REGISTRATION_TOKEN=your_admin_token

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://poshwue.com

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Stripe
STRIPE_SECRET_KEY=sk_test_...

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Shiprocket - required for orders to appear in dashboard (app.shiprocket.in → Manage Orders)
# IMPORTANT (403 fix): Use API user credentials, NOT your main Shiprocket login.
# Create API user: app.shiprocket.in → Settings → API → Configure → Create API User (different email).
# Use that API user's email and password below.
# Pickup: Settings → Company Profile → Pickup Locations; SHIPROCKET_PICKUP = exact location name (e.g. Primary)
SHIPROCKET_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=your_api_user_email@example.com
SHIPROCKET_PASSWORD=your_api_user_password
SHIPROCKET_PICKUP=Primary
SHIPROCKET_CHANNEL_ID=
PICKUP_PINCODE=110001
